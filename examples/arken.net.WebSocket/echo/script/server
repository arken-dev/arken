#!/usr/bin/env arken
-- arken.net.WebSocket example server - echo
--
-- Pré-requisito: esse exemplo só funciona num build com suporte a
-- WebSocket (backend "libev-ws"). Configure o CMake com:
--   cmake -DARKEN_NET_HTTPSERVER=libev-ws ..
-- (o backend padrão "libev", usado em produção, não entende upgrade
-- de WebSocket)
--
-- Como rodar (a partir da raiz do repositório):
--   cd examples/arken.net.WebSocket/echo
--   arken script/server
--
-- Endpoint WebSocket disponível (roteado pelo path do handshake, ver
-- lib/arken/net/websocketDispatcher.lua):
--   ws://127.0.0.1:8091/ws/echo   -> ws/controllers/EchoWebSocket.lua
--
-- Endpoint HTTP normal (página que abre a conexão WebSocket via JS, ver
-- app/views/index/index.html):
--   http://127.0.0.1:8091/       -> app/controllers/IndexController.lua
--
-- Porta diferente da do exemplo "chat" (8090) de propósito, pra dar pra
-- rodar os dois exemplos ao mesmo tempo sem conflito.

local json = require('arken.json')

local HttpServer = require('arken.net.HttpServer')
local config     = json.file('config/server.json')
local server     = HttpServer.new(config.address, config.port)

server:setThreads(config.threads)
server:setPid(config.pid)

-- server:setWebSocketDispatcher(...) não é chamado de propósito - o
-- padrão de fábrica (arken.net.websocketDispatcher) já resolve o path
-- pra classe do controller sozinho, não precisa de configuração pra
-- esse caso de uso simples.

-- Diferente do WebSocket, o roteamento HTTP normal não é automático -
-- precisa apontar explicitamente pro dispatcher baseado em convenção
-- (path /prefixo/controller/action -> prefixo.controllers.ControllerAction).
server:setDispatcher("lib.dispatcher")

server:start()
